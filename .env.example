# Copy to .env and fill in only what you want to switch on. Nothing here is needed for the core app.
# Read by zsc/config.py through the environment; never commit the real .env.

# Lineups, absences and minute-by-minute live data (https://www.api-football.com/, free tier 100 requests/day).
# Also set "enabled": true for api_football in config/settings.json. See docs/ACTIVATION.md.
API_FOOTBALL_KEY=

# Local server (python -m zsc serve). Use 0.0.0.0 only behind a reverse proxy with HTTPS on a public host.
ZSC_HOST=127.0.0.1
ZSC_PORT=8000
